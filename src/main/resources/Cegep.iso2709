22398r2024-06-17 00:00:00w2011-03-26yLIVRE  a3  c104643d10464301202nam a2200349 i 38179802CaQJC20170215142701.0t|                     990211s1997    qucŒŒŒŒŒŒŒŒŒŒ 0ŒŒ Œbfre d       a2760870545  a(CaQMCD)9711490  aCaQMCDbfre0 afre  aquc0 a971.403092bT197L0 a971.403092bT197L0 952109aLamarche, Jacques,d1922-200610aLouis-Alexandre Taschereau /cJacques Lamarche  aMontréal :bLidec,cc1997.  a62 p. :bill., cartes ;c22 cm.0 99687aCélébrités : collection biographique  aBibliogr.: p. 55-56.06aTaschereau, Louis Alexandre,d1867-1952915002606aTaschereau.q(Famille)9150029 6913166aPremiers ministreszQuébec (Province)vBiographiese 69106823aQuébec (Province)xPolitique et gouvernementy1920-1936  mL (BIO)  cLIVRE  00104070aCaQJCbCaQJCcLANAU.CGd2005-07-03l0o971.403092 T197Lp001456385r2025-01-14 00:00:00w2011-03-26yLIVRE  a3  c104659d10465901970nam a2200337 a   00104070aCaQJCbCaQJCcLANAU.CGd2007-03-19g76.95l1o658.1511 B684cp001792503r2024-07-19 00:00:00s2011-03-26w2011-03-26yLIVRE  c104663d10466342832068CaQJC20180717144418.0070319s1999????quc?????????? 0?? ? fre?c  a2761315197  aCaQJCbfre0 afre  aquc0 a658.1511bB684c  a658.1511bB684c1 933087aBoisvert, Hugues,d1946-13aLa comptabilité de management :bprise de décision et gestion /cHugues Boisvert, Claude Laurin, Alexander Mersereau  a3e éd.  aMontréal :bÉditions du Renouveau pédagogique,cc2004.  axx, 540 p. :bill. ;c26 cm.  aIndex: p. 525-540  aBibliogr. au bas des p.  aLe monde des affaires est assurément en pleine évolution, et la comptabilité de management, dont le rôle est d'orienter les gestionnaires dans la prise de décision, s'efforce de suivre cette évolution et parfois même de la devancer. Le manuel plonge immédiatement dans le contexte socio-économique du XXIe siècle pour présenter la comptabilité de management telle qu'elle s'exerce aujourd'hui dans les organisations canadiennes les plus admirées. Qu'il s'agisse de calcul et de gestion des coûts, de prise de décision, de planification et de contrôle stratégiques, de gestion de la performance et de la valeur, toutes ces questions constituent les défis, présents ou futurs, que doivent relever tant les entreprises manufacturières que les entreprises commerciales ou de services.  [Renaud-Bray] 6aComptabilité analytique97939 6aCoût de production933091 6aComptabilité de gestion9323871 aLaurin, Claude,91500391 aMersereau, Alexander9150041  2ddccLIVRE01275nam a2200289 a 450000100090000000300060000900500170001500800410003202000180007304000150009104100080010604400070011408200220012109200220014310000320016524500400019726000330023730000290027050400220029952004050032165000310072665000350075794200150079295201380080799900190094590100210096443376111CaQJC20240313084159.0080115s2007    fr ||||       000|0 fre    a9782296035362  aCaQJCbfre0 afre  afr0 a306.481909bB791t  a306.481909bB791t1 aBoyer, Marc,d1926-912289113aLe tourisme de masse /cMarc Boyer.  aParis :bL'Harmattan,c2007.  a165 p. :bill. ;c22 cm.  aBibliogr.: p. 163  aUne analyse du tourisme s'étendant à des catégories nouvelles non favorisées à partir des années 1930. L'étude décrit un processus socioculturel en relation avec le développement des moyens de transport comme les autocars et les trains. Un tourisme développant de nouveaux lieux d'hébergement collectif bon marché. Une pratique sociale plus présente dans les pays développés. [Memento] 6aTourismexHistoire9150093 6aTourismexAspect social919364  cLIVRE2ddc  00104070aCaQJCbCaQJCcLANAU.CGd2009-04-21l3m3o306.481909 B791tp001857218r2023-07-19 00:00:00s2019-08-26w2011-03-26yLIVRE  c104731d104731  bAmélie Gauthier01210nam a2200265 i 4500952013800000999001900138001000900157003000600166005001700172007000300189008005300192020001800245040002300263041000800286044000700294082001900301092001900320100003500339245005500374260004000429300002100469520041800490942001500908901002100923  00102ddc4070aCaQJCbCaQJCcLANAU.CGd2005-07-03l1o843.914 G244anp001407417r2024-08-08 00:00:00s2017-09-28w2011-03-26yLIVRE  c104735d10473538165523CaQJC20241217124638.0t|980331s1979    fr ŒŒŒŒŒŒŒŒŒŒ 0ŒŒ f fre c  a9782715200753  aCaQSICbfrecCaQJC0 afre  afr0 a843.914bG244a  a843.914bG244a1 aGary, Romain,d1914-19809187512aL'Angoisse du roi Salomon :broman /cÉmile Ajar.  aParis :bMercure de France,cc1979.  a342 p. ;c23 cm.  aJean, le narrateur, partage son temps entre son activité de chauffeur de taxi et ses lectures à la bibliothèque. Un jour, il fait la connaissance de Salomon, un ancien tailleur fortuné survivant de la Shoah qui lui propose de lui prêter de l'argent s'il accepte de travailler comme bénévole dans une association. Il rencontre ainsi Cora, une ancienne chanteuse qui semble bien connaître Salomon. [Memento]  cLIVRE2ddc  bAmélie Gauthier01511nam a2200313 a 4500952012200000999001900122001000900141003000600150005001700156008004100173020001500214020001800229040002300247041000800270044000700278082002100285092002100306100003600327245013300363260003300496300002100529504003400550520040900584534005200993650003901045650003601084650006201120942001501182  00104070aCaQJCbCaQJCcLANAU.CGd2007-04-23l0o303.48201 S634pp001796963r2023-07-19 00:00:00w2011-03-26yLIVRE  c104753d10475342860023CaQJC20180806125433.0070423s2001????fr  ????r???? 0?0 ? fre#c  a2350040321  a9782350040325  aCaQMCDbfredCaQJC1 afre  afr0 a303.48201bS634p  a303.48201bS634p1 96395aSloterdijk, Peter,d1947-13aLe palais de cristal :bà l'intérieur du capitalisme planétaire /cPeter Sloterdijk ; trad. de l'allemand par Olivier Mannoni  aParis :bMaren Sell,cc2006.  a379 p. ;c24 cm.  aNotes bibliogr. au bas des p.  aPour l'auteur, l'année 1492 sonne le début de la mondialisation, précédé par l'arrondissement d'une planète que l'on croyait plate. Esprit d'entreprise et goût du risque caractérisent ce phénomène qui a pris aujourd'hui une forme essentiellement économique. Dans la phase finale de la globalisation, le système mondial donne à toutes les formes de la vie les traits du capitalisme. [Memento]  pTitre original :tIm Weltinnenraum des Kapitals 6aMondialisationxPhilosophie944636 6aCapitalismexPhilosophie952731 6aCivilisation moderne et contemporainexPhilosophie952730  cLIVRE2ddc01680nam a2200361 a 43772670CaQJC20241206090525.0101217|||||||||fr     |||||||||||||fre||  a9782246754718  aCaQJCbfre0 afre  afr0 a261.22bF399t  a261.22bF399t1 aFerry, Luc,d1951-94361113aLa tentation du christianisme /cLuc Ferry et Lucien Jerphagnon  aParis :bGrasset,c2009.  a128 p. ;c19 cm. 0aNouveau collège de philosophie99999  a19.95$  a"Cette séance s'est tenue en Sorbonne dans l'amphithéâtre Descartes le 16 février 2008"--P. 11.  aNote (part. bibliogr.) au bas des p.  a"Scandale pour les juifs, folie pour les Grecs" : saint Paul désignait ainsi le christianisme. Contre la loi des juifs et la raison des philosophes, il entendait plaider en faveur du salut par une foi plus forte que la mort. Comment expliquer que ce scandale et cette folie aient pu finalement s'imposer à l'Empire romain ? Le philosophe et l'historien tentent de répondre à la question. [Memento] 6aChristianismexRelationsxReligion grecque9109099 6aReligion grecquexRelationsxChristianisme9150116 6aReligion romaine9150119 69115571aChristianisme et philosophie1 aJerphagnon, Lucien,d1921-2011924963  bAmélie C. Lepage  cLIVRE2ddc  00104070aCaQJCbCaQJCcLANAU.CGd2010-12-17l1o261.22 F399tp001955475r2023-07-13 00:00:00s2011-03-26w2011-03-26yLIVRE  c104777d10477701797nam a2200289 a 4500952013200000999001900132001000900151003000600160005001700166008004100183020001500224020001800239040002400257041000800281082001800289092001800307100003000325245003300355260003800388300002100426440003200447500001100479520092300490650004201413901003701455942001501492  00104070aCaQJCbCaQJCcLANAU.RLEAd2010-11-15l1o813.6 B877dep01949668r2024-06-14 00:00:00s2012-12-14w2011-03-26yLIVRE  c104779d10477943748949CaQJC20210318152617.0101115s2001||||nyu||||?|||||||||?|?eng||  a1416524800  a9781416524809  aCaQLCLLbfredCaQJC  aeng0 a813.6bB877de  a813.6bB877de1 aBrown, Dan,d1964-92168110aDeception point /cDan Brown  aNew York :bPocket books,cc2001.  a736 p. ;c19 cm. 0aPocket Books Fiction973998  a12.99$  aWhen a NASA satellite discovers an astonishingly rare object buried deep in the Arctic ice, the floundering space agency proclaims a much-needed victory—a victory with profound implications for NASA policy and the impending presidential election. To verify the authenticity of the find, the White House calls upon the skills of intelligence analyst Rachel Sexton. Accompanied by a team of experts, including the charismatic scholar Michael Tolland, Rachel travels to the Arctic and uncovers the unthinkable: evidence of scientific trickery—a bold deception that threatens to plunge the world into controversy. But before she can warn the president, Rachel and Michael are ambushed by a team of assassins. Fleeing for their lives across a desolate and lethal landscape, their only hope for survival is to discover who is behind this masterful plot. The truth, they will learn, is the most shocking deception of all. 69214451aRoman américainy21e siècle  bStéfany-Cristina Ocampo-Brodeur  cLIVRE2ddc01262nam a2200337 i 42701119CaQJC20181122145750.0mt|001005nuuuuuuuuqucŒŒŒŒŒŒŒŒŒŒ 0ŒŒ Œ fre c  a2551203082  aCaQMCLGbfredCaQJC0 afre  aquc0 a635.67297bJ43g0 a635.67297bJ43g0 994785aJean, Christine,d1952-10aGuide d'identification des insectes nuisibles et utiles dans la culture du mais sucré /crecherche, conception et rédaction, Christine Jean, Josée Boisclair  aMontréal :bInstitut de recherche et de développement en agroenvironnement,c[s.d.]  a24 p. :bill. en coul. ;c22 cm  aGlossaire au début du v. 6aMaïs sucréxMaladies et fléaux9150168 6930491aInsectes nuisiblesxLutte contre1 aBoisclair, Josée,d1958-91501712 aInstitut de recherche et de développement en agroenvironnement994791  mL  cLIVRE  00104070aCaQJCbCaQJCcLANAU.CGd2006-10-10g7.00l2o635.67297 J43gp001777618r2024-07-18 00:00:00s2014-08-28w2011-03-26yLIVRE  a3  c104829d10482902700nam a2200409 i 38203783CaQJC20230517000015.0mt|                     010406s1999    qucŒŒŒŒŒŒŒŒŒŒ 0ŒŒ Œ fre d       a2892242967  a(CaQMCD)A003210  aCaQMCDbfre0 afre  aquc0 a305.235bA849d0 a305.235bA849d2 aAssociation internationale des sociologues de langue française.bColloque (1997? : Evora, Portugal)915017210aDéfinir la jeunesse? :bd'un bout à l'autre du monde /csous la direction de Madeleine Gauthier et Jean-François Guillaume  aSainte-Foy :bÉditions de l'IQRC,c1999.  a270 p. ;c23 cm.00aCulture et société (Institut québécois de recherche sur la culture)9119427  aBibliogr. à la fin des textes.  aCet ouvrage réunit des chercheurs d'un bout à l'autre du monde autour d'une même question, l'étude de la jeunesse. De quelle manière faut-il aborder cette période du cycle de vie dont on parle avec abondance sans bien savoir comment la définir ?

Les mots sont non seulement porteurs de sens, mais servent aussi à orienter l'action. Les notions d'insertion, d'intégration ou de socialisation héritées de la tradition sociologique sont aujourd'hui récupérées dans des politiques où les jeunes se sentent souvent happés. Le statut d'acteurs qu'on leur a reconnu au beau temps de l'action étudiante ne continue-t-il à s'appliquer que dans les sociétés où les jeunes sont majoritaires ? Les sociétés vieillissantes laissent-elles un peu de place aux jeunes pour l'élaboration de stratégies ?

Les études qui portent aujourd'hui sur la jeunesse impliquent de démêler les intentions derrière les discours. Dans un contexte de mutation ou de (ré)invention du lien social, le pari à relever n'en est que plus passionnant. [Renaud-Bray]  aTextes présentés lors d'un colloque de l'Association internationale des sociologues de langue française tenu à Evora, Portugal. 6aJeunessexAspect sociologique913853 6aJeunessexAttitudes946937 4aJeunessexConditions sociales992974 6aJeunessexOpinion publique9361748 6aActes de congrès93000021 aGuillaume, Jean-François91501790 977779aGauthier, Madeleine,d1940-  bCRON CRON  cLIVRE2ddc  00104070aCaQJCbCaQJCcLANAU.CGd2005-07-03l1o305.235 A849dp001660073r2023-07-19 00:00:00s2013-02-13w2011-03-26yLIVRE  c104831d10483101084nam a22003132  450000100090000000300060000900500170001500800540003202000150008604000150010104100080011604400080012408200180013209200180015010000400016824500860020826000530029430000210034744000350036865000210040365000560042465000290048065000360050965000390054590100210058494200150060595201310062099900190075138193181CaQJC20240827144747.0910211s1990    qucŒŒŒŒŒŒŒŒŒŒ 0ŒŒ Œ fre c  a2890910997  aCaQJCbfre0 afre  aquc0 a305.42bB535m  a305.42bB535m1 950227aBersianik, Louky,d1930-201113aLa main tranchante du symbole :btextes et essais féministes /cLouky Bersianik.  aMontréal :bÉditions du Remue-ménage,cc1990.  a280 p. ;c23 cm.0 aItinéraires féministes93861 6aFéminisme93103 6aLittérature féministezQuébec (Province)9150244 6aStructure sociale986207 69106115aPatriarcat (Sociologie) 6aFemmesxConditions sociales930607  bAmélie Gauthier  cLIVRE2ddc  00104070aCaQJCbCaQJCcLANAU.CGd2005-07-03l1o305.42 B535mp001552979r2023-07-19 00:00:00s2021-09-02w2011-03-26yLIVRE  c104885d10488502068nam a2200301 a 450000100090000000300060000900500170001500800410003202000260007302000240009904000230012304100080014604400080015408200180016209200180018010000360019824500950023426000640032930000210039344000380041452010750045253400390152765000260156690100210159294200150161395201190162899900190174742606226CaQJC20241112145546.0051213s2005????quc    |      000 f fre#c  a2742756485qActes Sud  a2760925064qLeméac  aCaQMBNbfredCaQJC1 afre  aquc0 a813.54bA934b  a813.54bA934b1 aAuster, Paul,d1947-202491748110aBrooklyn follies :broman /cPaul Auster ; traduit de l'américain par Christine Le Boeuf.  aArles, France :bActes Sud ;aMontréal :bLeméac,cc2005.  a363 p. ;c22 cm. 0920971aLettres anglo-américaines  aJe cherchais un endroit tranquille où mourir. Quelqu’un me conseilla Brooklyn et, dès le lendemain matin, je m’y rendis de Westchester afin de reconnaître le terrain. Il y avait cinquante-six ans que je n’étais pas revenu là et je ne me souvenais de rien. Je n’avais que trois ans lorsque mes parents avaient quitté la ville, et pourtant je m’aperçus que je retournais d’instinct au quartier que nous avions habité, à la manière d’un chien blessé qui se traîne vers le lieu de sa naissance. Un agent immobilier du coin me fit visiter six ou sept appartements dans des maisons de pierre brune et à la fin de l’après-midi j’avais loué un trois-pièces avec jardin dans la Première Rue, non loin de Prospect Park. J’ignorais tout de mes voisins et ça m’était bien égal. Tous travaillaient de neuf à dix-sept heures, aucun n’avait d’enfants et l’immeuble serait donc relativement silencieux. Plus qu’à toute autre chose, c’était à cela que j’aspirais. Une fin silencieuse à ma vie triste et ridicule... [Renaud-Bray]  pTitre original:tBrooklyn follies. 6aRoman américain9573  bAmélie Gauthier  cLIVRE2ddc  00104070aCaQJCbCaQJCcLANAU.CGd2006-05-04l0o813.54 A934bp001766146r2024-07-24 00:00:00w2011-03-26yLIVRE  c104989d10498901117nam a2200349 i 38154388CaQJC20250128131122.0mt|                     960227s1995    qucŒŒŒŒŒŒŒŒŒŒ 0ŒŒ Œ fre c       a